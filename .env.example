# Environment
ENV=development

# LLM configuration
LLM_PROVIDER=openai
LLM_MODEL=

# Embeddings / Reranker
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base

# Vector DB
VECTOR_DB_URL=http://localhost:6333

# Retrieval hyperparams
TOP_K_VECTOR=20
TOP_K_BM25=20
TOP_K_RRF=10
TOP_K_RERANK=5
RRF_K=60

# Logging
LOG_LEVEL=INFO

# Secrets (do not commit real values)
EMBEDDINGS_API_KEY=
LLM_API_KEY=
